{
 "$defs": {
  "__schema0": {
   "type": "object",
   "properties": {
    "present": {
     "type": "boolean"
    },
    "widthMm": {
     "type": "number"
    },
    "depthMm": {
     "type": "number"
    }
   },
   "additionalProperties": false,
   "required": [
    "present",
    "widthMm",
    "depthMm"
   ]
  },
  "__schema1": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "description": "room = walls all round; open = under the roof without its own walls (parking, porch, verandah); balcony = projecting balcony on an upper floor; terrace = open to the sky.\n\n{enum: [\"room\",\"open\",\"balcony\",\"terrace\"]}"
    },
    "xMm": {
     "type": "number",
     "description": "Front-left corner from the building's front-left corner, along X, mm."
    },
    "yMm": {
     "type": "number",
     "description": "Front-left corner from the building's front-left corner, along Y (front to back), mm."
    },
    "widthMm": {
     "type": "number",
     "description": "Along X, mm."
    },
    "depthMm": {
     "type": "number",
     "description": "Along Y, mm."
    }
   },
   "additionalProperties": false,
   "required": [
    "name",
    "kind",
    "xMm",
    "yMm",
    "widthMm",
    "depthMm"
   ]
  },
  "__schema2": {
   "type": "object",
   "properties": {
    "type": {
     "type": "string",
     "description": "{enum: [\"door\",\"window\"]}"
    },
    "xMm": {
     "type": "number",
     "description": "Centre on the plan, same origin as the rooms, mm."
    },
    "yMm": {
     "type": "number"
    },
    "widthMm": {
     "type": "number"
    },
    "heightMm": {
     "type": "number"
    },
    "sillMm": {
     "type": "number",
     "description": "0 for doors."
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "xMm",
    "yMm",
    "widthMm",
    "heightMm",
    "sillMm"
   ]
  }
 },
 "type": "object",
 "properties": {
  "structureKind": {
   "type": "string",
   "description": "building = rooms on a column grid with a roof slab; boundary-wall = compound / boundary wall (piers on a line or around a plot, no roof); other = anything else, listed in \"elements\".\n\n{enum: [\"building\",\"boundary-wall\",\"other\"]}"
  },
  "projectName": {
   "type": "string",
   "description": "Project / building name as written on the drawing title block, e.g. \"Security Cabin\"."
  },
  "buildingName": {
   "type": "string"
  },
  "xSpansMm": {
   "type": "array",
   "description": "Centre-to-centre spacing between consecutive vertical grid lines, left to right, in mm.",
   "items": {
    "type": "number"
   }
  },
  "ySpansMm": {
   "type": "array",
   "description": "Centre-to-centre spacing between consecutive horizontal grid lines, bottom (front) to top, in mm.",
   "items": {
    "type": "number"
   }
  },
  "columnTypes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "code": {
      "type": "string"
     },
     "widthMm": {
      "type": "number"
     },
     "depthMm": {
      "type": "number"
     },
     "footingCode": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "code",
     "widthMm",
     "depthMm",
     "footingCode"
    ]
   }
  },
  "footingTypes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "code": {
      "type": "string"
     },
     "lengthMm": {
      "type": "number"
     },
     "widthMm": {
      "type": "number"
     },
     "depthMm": {
      "type": "number"
     }
    },
    "additionalProperties": false,
    "required": [
     "code",
     "lengthMm",
     "widthMm",
     "depthMm"
    ]
   }
  },
  "columns": {
   "type": "array",
   "description": "Every column position.",
   "items": {
    "type": "object",
    "properties": {
     "grid": {
      "type": "string",
      "description": "Grid point like \"X1Y1\" (X from left, Y from bottom/front)."
     },
     "columnCode": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "grid",
     "columnCode"
    ]
   }
  },
  "foundationDepthMm": {
   "type": "number",
   "description": "Bottom of footing below ground / plinth level, mm (positive number)."
  },
  "roofLevelMm": {
   "type": "number",
   "description": "Top of roof beams = bottom of roof slab, above ground / plinth level, mm."
  },
  "plinthBeam": {
   "$ref": "#/$defs/__schema0"
  },
  "roofBeam": {
   "$ref": "#/$defs/__schema0"
  },
  "slab": {
   "type": "object",
   "properties": {
    "present": {
     "type": "boolean"
    },
    "thicknessMm": {
     "type": "number"
    },
    "overhangMm": {
     "type": "number"
    }
   },
   "additionalProperties": false,
   "required": [
    "present",
    "thicknessMm",
    "overhangMm"
   ]
  },
  "walls": {
   "type": "object",
   "properties": {
    "present": {
     "type": "boolean"
    },
    "thicknessMm": {
     "type": "number"
    },
    "alsoOnInternalGridLines": {
     "type": "boolean"
    }
   },
   "additionalProperties": false,
   "required": [
    "present",
    "thicknessMm",
    "alsoOnInternalGridLines"
   ]
  },
  "openingTypes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "mark": {
      "type": "string"
     },
     "kind": {
      "type": "string",
      "description": "{enum: [\"door\",\"window\",\"ventilator\"]}"
     },
     "widthMm": {
      "type": "number"
     },
     "heightMm": {
      "type": "number"
     },
     "sillMm": {
      "type": "number",
      "description": "Height of the opening bottom above floor; 0 for doors."
     }
    },
    "additionalProperties": false,
    "required": [
     "mark",
     "kind",
     "widthMm",
     "heightMm",
     "sillMm"
    ]
   }
  },
  "openings": {
   "type": "array",
   "description": "Every door / window / ventilator placed in a wall.",
   "items": {
    "type": "object",
    "properties": {
     "mark": {
      "type": "string"
     },
     "fromGrid": {
      "type": "string",
      "description": "Grid point at one end of the wall the opening is in, e.g. \"X1Y1\"."
     },
     "toGrid": {
      "type": "string",
      "description": "Grid point at the other end of that wall, on the same grid line, e.g. \"X2Y1\"."
     },
     "centreFromStartMm": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "Distance from fromGrid to the opening centre along the wall, mm; null if centred."
     }
    },
    "additionalProperties": false,
    "required": [
     "mark",
     "fromGrid",
     "toGrid",
     "centreFromStartMm"
    ]
   }
  },
  "lintel": {
   "type": "object",
   "properties": {
    "present": {
     "type": "boolean"
    },
    "depthMm": {
     "type": "number"
    }
   },
   "additionalProperties": false,
   "required": [
    "present",
    "depthMm"
   ]
  },
  "chhajja": {
   "type": "object",
   "properties": {
    "present": {
     "type": "boolean"
    },
    "projectionMm": {
     "type": "number"
    },
    "thicknessMm": {
     "type": "number"
    }
   },
   "additionalProperties": false,
   "required": [
    "present",
    "projectionMm",
    "thicknessMm"
   ]
  },
  "elements": {
   "type": "array",
   "description": "Only when structureKind is \"other\": every element as a box. Empty otherwise.",
   "items": {
    "type": "object",
    "properties": {
     "code": {
      "type": "string"
     },
     "type": {
      "type": "string",
      "description": "{enum: [\"footing\",\"column\",\"beam\",\"slab\",\"wall\",\"lintel\",\"chhajja\",\"door\",\"window\"]}"
     },
     "xMm": {
      "type": "number",
      "description": "Centre on the plan, from the left edge, mm."
     },
     "yMm": {
      "type": "number",
      "description": "Centre on the plan, from the front (bottom) edge, mm."
     },
     "bottomMm": {
      "type": "number",
      "description": "Level of the underside; 0 = ground, negative below ground, mm."
     },
     "lengthMm": {
      "type": "number",
      "description": "Size along X, mm."
     },
     "widthMm": {
      "type": "number",
      "description": "Size along Y, mm."
     },
     "heightMm": {
      "type": "number"
     }
    },
    "additionalProperties": false,
    "required": [
     "code",
     "type",
     "xMm",
     "yMm",
     "bottomMm",
     "lengthMm",
     "widthMm",
     "heightMm"
    ]
   }
  },
  "rooms": {
   "type": "array",
   "description": "For structureKind \"building\": every room / space as a rectangle covering the whole plan. Empty otherwise.",
   "items": {
    "$ref": "#/$defs/__schema1"
   }
  },
  "roomOpenings": {
   "type": "array",
   "description": "For structureKind \"building\": every door and window, centred on the wall line it is in. Empty otherwise.",
   "items": {
    "$ref": "#/$defs/__schema2"
   }
  },
  "upperFloors": {
   "type": "array",
   "description": "For structureKind \"building\": every floor above the ground floor, bottom to top, same origin as the ground-floor rooms. Empty for one storey.",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "description": "e.g. \"First floor\"."
     },
     "floorToFloorMm": {
      "type": "number",
      "description": "From the roof level of the floor below to this floor's roof level, mm."
     },
     "rooms": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/__schema1"
      }
     },
     "roomOpenings": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/__schema2"
      }
     }
    },
    "additionalProperties": false,
    "required": [
     "name",
     "floorToFloorMm",
     "rooms",
     "roomOpenings"
    ]
   }
  },
  "parapet": {
   "type": "object",
   "properties": {
    "present": {
     "type": "boolean"
    },
    "heightMm": {
     "type": "number"
    },
    "thicknessMm": {
     "type": "number"
    }
   },
   "additionalProperties": false,
   "required": [
    "present",
    "heightMm",
    "thicknessMm"
   ]
  },
  "mumty": {
   "type": "object",
   "description": "Stair cabin on the roof over the top-floor stair.",
   "properties": {
    "present": {
     "type": "boolean"
    },
    "heightMm": {
     "type": "number"
    }
   },
   "additionalProperties": false,
   "required": [
    "present",
    "heightMm"
   ]
  },
  "assumptions": {
   "type": "array",
   "description": "Every value NOT written on the drawing that you assumed, and why. Empty if none.",
   "items": {
    "type": "string"
   }
  },
  "confidence": {
   "type": "string",
   "description": "{enum: [\"high\",\"medium\",\"low\"]}"
  }
 },
 "additionalProperties": false,
 "required": [
  "structureKind",
  "projectName",
  "buildingName",
  "xSpansMm",
  "ySpansMm",
  "columnTypes",
  "footingTypes",
  "columns",
  "foundationDepthMm",
  "roofLevelMm",
  "plinthBeam",
  "roofBeam",
  "slab",
  "walls",
  "openingTypes",
  "openings",
  "lintel",
  "chhajja",
  "elements",
  "rooms",
  "roomOpenings",
  "upperFloors",
  "parapet",
  "mumty",
  "assumptions",
  "confidence"
 ],
 "description": "{$schema: \"https://json-schema.org/draft/2020-12/schema\"}"
}
