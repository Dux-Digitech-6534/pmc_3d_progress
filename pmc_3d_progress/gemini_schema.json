    },
    "depthMm": {
     "type": "number"
    }
   },
   "required": [
    "present",
    "depthMm"
   ],
   "additionalProperties": false
  },
  "chhajja": {
   "type": "object",
   "properties": {
    "present": {
     "type": "boolean"
    },
    "projectionMm": {
     "type": "number"
    },
    "thicknessMm": {
     "type": "number"
    }
   },
   "required": [
    "present",
    "projectionMm",
    "thicknessMm"
   ],
   "additionalProperties": false
