   "items": {
    "type": "number"
   }
  },
  "columnTypes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "code": {
      "type": "string"
     },
     "widthMm": {
      "type": "number"
     },
     "depthMm": {
      "type": "number"
     },
     "footingCode": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "widthMm",
     "depthMm",
     "footingCode"
    ],
    "additionalProperties": false
   }
  },
  "footingTypes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "code": {
