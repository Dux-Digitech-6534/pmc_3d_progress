       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "mark",
     "fromGrid",
     "toGrid",
     "centreFromStartMm"
    ],
    "additionalProperties": false
   }
  },
  "lintel": {
   "type": "object",
   "properties": {
